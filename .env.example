
# ==========================================
# Smart City - Local Development
# ==========================================

APP_ENV=development

# ==========================================
# Service Registry
# ==========================================

REGISTRY_API_KEY=replace-with-a-random-secret

# Registry PostgreSQL database
POSTGRES_PASSWORD=replace-with-a-registry-database-password

REGISTRY_DATABASE_PATH=/app/data/registry.db
REGISTRY_HEARTBEAT_INTERVAL_SECONDS=5
REGISTRY_EXPIRY_SCAN_SECONDS=1

# ==========================================
# Construction & Incidents (S3) Database
# ==========================================

# Dedicated PostgreSQL/PostGIS database for S3
INCIDENTS_POSTGRES_PASSWORD=replace-with-an-incidents-database-password

# Optional S4-owned ingestion database (compose.parking.db.yml); use URL-safe characters.
PARKING_DB_PASSWORD=replace-with-a-url-safe-parking-database-password

# ==========================================
# Service Registration
# ==========================================

REGISTRY_URL=http://service-registry:8080

# ==========================================
# S2, S3 and S4 Authentication
# ==========================================

# ==========================================
# Keycloak Identity Provider
# ==========================================

KEYCLOAK_DB_PASSWORD=replace-with-a-strong-database-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Keycloak-issued JWT configuration, shared by S2, S3 and S4 resource servers.
JWT_ISSUER=http://localhost:8088/realms/smart-city
JWT_AUDIENCE=smart-city-api
JWT_JWKS_URL=http://keycloak:8080/realms/smart-city/protocol/openid-connect/certs

# Expected signed role claim and moderator role value.
JWT_ALLOW_INSECURE_JWKS=true
JWT_ROLE_CLAIM=roles
JWT_MODERATOR_ROLE=moderator

# Token clock tolerance and JWKS request timeout.
JWT_LEEWAY_SECONDS=30
JWT_JWKS_TIMEOUT_SECONDS=5
